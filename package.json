{
  "name": "founder-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:low-memory": "node --expose-gc --import tsx --import ./scripts/test-cleanup.mjs --test --test-concurrency=1 tests/*.test.ts",
    "test:runtime": "tsc -p tsconfig.runtime.json && node --test .local/runtime/tests/vercel-adapter.test.js",
    "start": "tsx scripts/dev.ts --production",
    "mcp": "tsx scripts/mcp.ts",
    "skills:verify": "node scripts/verify-skills.mjs",
    "check": "npm run build && npm run test:low-memory && npm run test:runtime",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "build:edge": "node scripts/build-edge.mjs",
    "migrate:snapshot": "tsx scripts/migrate-airtable.ts --snapshot",
    "prebuild": "node scripts/prepare-build.mjs",
    "qa": "tsx scripts/qa-server.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "@fontsource/geist": "^5.2.0",
    "@fontsource/geist-mono": "^5.2.0",
    "@hono/node-server": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.0.0",
    "clsx": "^2.1.1",
    "hono": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.0.0",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
