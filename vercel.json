{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["icn1"],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": { "NODEJS_HELPERS": "0" },
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/mcp", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/share/:path*", "destination": "/api" },
    { "source": "/((?!api|assets|share).*)", "destination": "/index.html" }
  ]
}
